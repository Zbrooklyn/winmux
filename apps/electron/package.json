{
  "name": "winmux",
  "version": "0.2.7",
  "private": true,
  "description": "A terminal multiplexer and agent cockpit for Windows — native desktop app, browser, and phone over Tailscale.",
  "license": "MIT",
  "author": "Zbrooklyn",
  "homepage": "https://github.com/Zbrooklyn/winmux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zbrooklyn/winmux.git"
  },
  "bugs": {
    "url": "https://github.com/Zbrooklyn/winmux/issues"
  },
  "keywords": [
    "terminal",
    "multiplexer",
    "tmux",
    "windows",
    "powershell",
    "node-pty",
    "xterm",
    "electron",
    "tailscale",
    "ssh-alternative"
  ],
  "main": "dist-electron/main.js",
  "bin": {
    "winmux": "bin/winmux.cjs",
    "winmux-mcp": "bin/winmux-mcp.cjs"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "remote": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 start",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 stop",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 status",
    "link": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 link",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "npm run build:electron && electron dist-electron/main.js",
    "verify": "npm run build:electron && node scripts/verify-both.cjs",
    "verify:coexist": "node verify-coexist.cjs",
    "pack": "npm run build:electron && electron-builder --dir",
    "dist": "npm run build:electron && node scripts/dist.cjs",
    "dist:rust": "node scripts/dist-rust.cjs",
    "winget": "node scripts/winget-manifest.mjs",
    "perf": "node perf.cjs",
    "endurance": "node endurance.cjs",
    "dist:node": "npm run build:electron && node scripts/dist-node.cjs",
    "dist:node-app": "npm run build:electron && node scripts/dist-node-app.cjs",
    "start:node": "node scripts/start.cjs --node",
    "verify:node": "npm run build:electron && node verify.cjs",
    "verify:rust": "npm run build:electron && node scripts/verify-both.cjs --rust-only"
  },
  "build": {
    "appId": "com.zbrooklyn.winmux",
    "productName": "WinMux",
    "npmRebuild": false,
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "server.cjs",
      "public/**/*",
      "dist-electron/**/*",
      "bin/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**",
      "node_modules/node-pty/build/Release/*.node",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WinMux Setup ${version}.${ext}"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2"
  }
}
