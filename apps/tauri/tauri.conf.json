{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinMux Tauri",
  "version": "0.2.7",
  "identifier": "com.zbrooklyn.winmux.tauri",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../electron/public": "public",
      "../../core/rust/target/release/winmux-core.exe": "winmux-core.exe"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
