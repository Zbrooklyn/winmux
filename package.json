{
  "name": "winmux",
  "version": "0.1.0",
  "private": true,
  "description": "WinMux — a terminal multiplexer for Windows: one node-pty server with three faces (native Electron app, browser, and phone over Tailscale).",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "remote": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 start",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 stop",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 status",
    "link": "powershell -NoProfile -ExecutionPolicy Bypass -File winmux.ps1 link",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "npm run build:electron && electron dist-electron/main.js",
    "verify": "npm run build:electron && node verify.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2"
  }
}
